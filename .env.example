# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive Service Account (used to create per-student folders + upload docs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID of the Drive folder that holds every student folder (must be shared with the SA above)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Resend (transactional email)
RESEND_API_KEY=re_your_key
# Use a verified domain in production (e.g. referrals@yourdomain.com).
# `onboarding@resend.dev` works for testing only and lands in spam.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=replies@yourdomain.com

# App
NEXT_PUBLIC_APP_NAME="Bridge to Malaysia"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile — CAPTCHA on /start (free)
# Sign up at https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — rate limit on /api/public/intake (free tier OK)
# Sign up at https://upstash.com → Redis → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
